# Non-secret configuration only. The database password is passed separately by
# the service manager. Do not place provider keys or admin tokens in this file.
PRAIMATE_REMOTE_LISTEN=127.0.0.1:8844
# For a direct network listener, configure TLS and change the address:
# PRAIMATE_REMOTE_LISTEN=0.0.0.0:8844
# PRAIMATE_REMOTE_TLS_CERT=/absolute/path/server-fullchain.pem
# PRAIMATE_REMOTE_TLS_KEY=/absolute/path/server-key.pem
# Extra exact origins for a separately hosted client or future Android WebView:
# PRAIMATE_REMOTE_ORIGINS=https://localhost,capacitor://localhost
